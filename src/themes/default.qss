/*
 * Kate AI chat widget skin — built-in default (dark).
 *
 * "@token" is substituted from <name>.theme before the sheet reaches Qt, which
 * has no CSS variables.  Literal colour values are not allowed here.
 *
 * Rules are scoped by widget class or object name and applied only to widgets
 * the chat panel owns, so they do not affect the rest of Kate.  A skin may ship
 * its own <name>.qss instead of this file.
 */

/* ---- transcript ---------------------------------------------------------- */
QScrollArea#transcriptScroll {
    background-color: @bg_base;
    border: none;
}
QScrollArea#transcriptScroll > QWidget > QWidget {
    background-color: @bg_base;
}
QScrollArea#transcriptScroll QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}
QScrollArea#transcriptScroll QScrollBar::handle:vertical {
    background: @scroll_handle;
    border-radius: 4px;
    min-height: 24px;
}
QScrollArea#transcriptScroll QScrollBar::handle:vertical:hover {
    background: @scroll_handle_hover;
}
QScrollArea#transcriptScroll QScrollBar::add-line:vertical,
QScrollArea#transcriptScroll QScrollBar::sub-line:vertical {
    height: 0;
}

/* ---- toolbar ------------------------------------------------------------- */
QLabel#threadTitle {
    color: @text_faint;
    font-size: 12px;
    font-weight: 500;
    padding-left: 4px;
}
QPushButton#modelSelector {
    background-color: @bg_elevated;
    color: @text_dim;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 500;
    text-align: left;
}
QPushButton#modelSelector:hover {
    background-color: @bg_hover;
    border-color: @border_strong;
    color: @text_strong;
}
QPushButton#toolbarIconButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
}
QPushButton#toolbarIconButton:hover {
    background-color: @bg_hover;
    border-color: @border;
}

/* ---- status indicators --------------------------------------------------- */
QLabel#thinkingIndicator {
    color: @thinking_line;
    font-size: 11px;
    font-style: italic;
    padding: 2px 10px;
    background-color: @banner_bg;
    border: 1px solid @banner_border;
    border-radius: 10px;
    min-width: 108px;
}
QLabel#workingIndicator {
    color: @thinking_fg;
    font-size: 11px;
    font-style: italic;
    padding: 2px 10px;
    background-color: @thinking_bg;
    border: 1px solid @thinking_fg;
    border-radius: 10px;
    min-width: 108px;
}

/* ---- jump to latest ------------------------------------------------------ */
QPushButton#jumpToLatest {
    background-color: @accent_alt;
    color: @accent_text;
    border: 1px solid @accent_line;
    border-radius: 14px;
    padding: 5px 12px;
    font-size: 11px;
    font-weight: 600;
}
QPushButton#jumpToLatest:hover {
    background-color: @accent_alt_hover;
    border-color: @accent_ring;
}

/* ---- user message card --------------------------------------------------- */
QWidget#userMessageCard {
    background-color: @bg_raised;
    border: 1px solid @border_card;
    border-radius: 6px;
}
QLabel#userMessageHeader {
    color: @text_faint;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 0.5px;
    border: none;
    background: transparent;
}
QLabel#userMessageBody {
    color: @text_normal;
    font-size: 13px;
    border: none;
    background: transparent;
}

/* ---- assistant message --------------------------------------------------- */
QLabel#assistantIcon,
QLabel#assistantPulse {
    color: @accent_line;
    font-size: 12px;
}
QLabel#assistantPulse {
    font-size: 9px;
    padding-left: 4px;
}
QLabel#assistantHeader {
    color: @accent_line;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 0.5px;
}
QTextBrowser#assistantBrowser {
    background: transparent;
    color: @text_assistant;
    border: none;
    padding: 0px;
}

/* ---- thinking block ------------------------------------------------------ */
QPushButton#thinkingToggle {
    color: @text_faint;
    font-size: 11px;
    font-style: italic;
    border: none;
    text-align: left;
}
QPushButton#thinkingToggle:hover {
    color: @text_soft;
}
QTextBrowser#thinkingBrowser {
    background: transparent;
    color: @text_muted;
    border: none;
    font-style: italic;
    font-size: 12px;
    padding: 4px;
}

/* ---- plan checklist ------------------------------------------------------ */
QLabel#planHeader {
    color: @text_faint;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 0.5px;
}
QCheckBox#planStep {
    color: @text_soft;
    font-size: 12px;
}
QCheckBox#planStep::indicator {
    width: 14px;
    height: 14px;
}

/* ---- activity pill ------------------------------------------------------- */
QLabel#activityPill {
    color: @text_subtle;
    font-size: 11px;
    font-style: italic;
    padding: 2px 4px;
}

/* ---- copy button --------------------------------------------------------- */
QPushButton#copyButton {
    color: @text_faint;
    background-color: transparent;
    border: 1px solid @border_soft;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 11px;
}
QPushButton#copyButton:hover {
    color: @text_strong;
    background-color: @bg_hover_alt;
    border-color: @border_hover;
}
QPushButton#copyButton[copied="true"] {
    color: @success;
    background-color: @success_bg;
    border: 1px solid @success;
}

/* ---- welcome ------------------------------------------------------------- */
QLabel#welcomeIcon {
    font-size: 24px;
    color: @brand;
}
QLabel#welcomeTitle {
    color: @text_normal;
    font-size: 14px;
    font-weight: bold;
}
QLabel#welcomeSubtitle {
    color: @text_subtle;
    font-size: 11px;
    margin-bottom: 8px;
}
QPushButton#welcomeChip {
    background-color: @bg_raised_alt;
    color: @text_dim;
    border: 1px solid @border_card;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 11px;
    text-align: left;
}
QPushButton#welcomeChip:hover {
    background-color: @bg_hover_soft;
    border-color: @border_hover;
    color: @text_strong;
}

/* ---- composer ------------------------------------------------------------ */
QWidget#composerContainer {
    background-color: @bg_surface;
    border-top: 1px solid @border_soft;
}
QWidget#composerCard {
    background-color: @bg_raised;
    border: 1px solid @border_soft;
    border-radius: 8px;
}
QLabel#infoBar {
    font-size: 12px;
    font-weight: bold;
    padding: 8px 12px;
    background: transparent;
    border: none;
    color: @warn_fg;
}
QLabel#infoBar[severity="warning"] {
    color: @warn_info;
}
QPlainTextEdit#promptEdit {
    background: transparent;
    color: @text_normal;
    border: none;
    padding: 2px;
    font-size: 13px;
}
QLabel#tokenCount {
    color: @text_placeholder;
    font-size: 11px;
}
QLabel#composerStatus {
    color: @text_disabled;
    font-size: 11px;
    margin-left: 4px;
}

/* ---- composer buttons ---------------------------------------------------- */
QPushButton#thinkingButton {
    color: @text_faint;
    background-color: @bg_elevated;
    border: 1px solid @border;
    border-radius: 4px;
    font-size: 14px;
}
QPushButton#thinkingButton:hover {
    background-color: @bg_hover;
    border-color: @border_strong;
    color: @text_soft;
}
QPushButton#thinkingButton[thinking="true"] {
    color: @text_strong;
    background-color: @success_deep;
    border: 1px solid @success_border;
}
QPushButton#thinkingButton[thinking="true"]:hover {
    background-color: @success_deep_hover;
    border-color: @success_hover;
}
QPushButton#reasoningEffortButton {
    color: @text_faint;
    background-color: @bg_elevated;
    border: 1px solid @border;
    border-radius: 4px;
    font-size: 12px;
    font-weight: bold;
}
QPushButton#reasoningEffortButton:hover {
    background-color: @bg_hover;
    border-color: @border_strong;
    color: @text_dim;
}
QPushButton#reasoningEffortButton[effort="set"] {
    color: @text_strong;
    background-color: @accent;
    border: 1px solid @accent_hover;
}
QPushButton#reasoningEffortButton[effort="set"]:hover {
    background-color: @accent_hover;
    border-color: @accent_line_hover;
}
QPushButton#reasoningEffortButton[effort="unsupported"] {
    color: @text_placeholder;
    background-color: @bg_sunken;
    border: 1px solid @border_card;
}
QPushButton#reasoningEffortButton[effort="unsupported"]:hover {
    background-color: @bg_hover_alt;
    border-color: @border;
    color: @text_faint;
}
QPushButton#sendButton {
    color: @text_strong;
    background-color: @accent;
    font-size: 13px;
    border: none;
    border-radius: 4px;
}
QPushButton#sendButton:hover {
    background-color: @accent_deep;
}
QPushButton#sendButton:disabled {
    color: @text_disabled;
    background-color: @bg_elevated;
    border: 1px solid @border_soft;
}
QPushButton#sendButton[mode="stop"] {
    color: @text_strong;
    background-color: @danger;
}
QPushButton#sendButton[mode="stop"]:hover {
    background-color: @danger_hover;
}

/* ---- popup menus (model picker, settings, history, reasoning) ------------- */
QMenu {
    background-color: @bg_menu;
    color: @text_dim;
    border: 1px solid @border;
    border-radius: 6px;
    padding: 4px;
}
QMenu::item {
    padding: 6px 18px 6px 12px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: @accent;
    color: @accent_text;
}
QMenu::separator {
    height: 1px;
    background-color: @border_soft;
    margin: 4px 0;
}
QLineEdit#modelFilter {
    background-color: @bg_input;
    color: @text_normal;
    border: 1px solid @border_soft;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 12px;
}
QLineEdit#modelFilter:focus {
    border-color: @accent;
}
